DB_URL=jdbc:postgresql://localhost:5432/e_walletDB
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Set to true only when you want DataInitializer to seed an admin user (e.g. fresh local DB)
APP_INITIAL_ADMIN_ENABLED=false
APP_INITIAL_ADMIN_FIRST_NAME=System
APP_INITIAL_ADMIN_MIDDLE_NAME=N/A
APP_INITIAL_ADMIN_LAST_NAME=Admin
APP_INITIAL_ADMIN_EMAIL=admin@example.com
APP_INITIAL_ADMIN_PHONE=+255700000000
APP_INITIAL_ADMIN_PIN=1234

# SMTP settings for OTP verification emails
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USER=your_email@gmail.com
APP_MAIL_PASS=your_app_password_here

# Secret used to sign JWTs — generate a real random 256-bit (64 hex char) value, never reuse this example
JWT_SECRET=replace_with_a_random_64_character_hex_string

#API KEYS FOR PLAID SANDBOX
PLAID_CLIENT_ID=your_plaid_sandbox_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here

# Plaid bank linking (Sandbox only)
PLAID_ENV=sandbox
# Sandbox banks never carry a WalletPesa customer's name. true skips the own-bank name check, in Sandbox only.
PLAID_SANDBOX_SKIP_NAME_MATCH=true
# Encrypts bank access tokens. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=generate_a_32_byte_base64_key
