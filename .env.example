DB_URL=jdbc:postgresql://localhost:5432/e_walletDB
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Set to true only when you want DataInitializer to seed an admin user (e.g. fresh local DB)
APP_INITIAL_ADMIN_ENABLED=false
APP_INITIAL_ADMIN_FIRST_NAME=System
APP_INITIAL_ADMIN_MIDDLE_NAME=N/A
APP_INITIAL_ADMIN_LAST_NAME=Admin
APP_INITIAL_ADMIN_EMAIL=admin@example.com
APP_INITIAL_ADMIN_PHONE=+255700000000
APP_INITIAL_ADMIN_PASSWORD=your_strong_password_here
